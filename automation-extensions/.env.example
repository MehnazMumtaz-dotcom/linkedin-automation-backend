# Server
PORT=3005
NODE_ENV=development

# Supabase (shared with the Python engine)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python scraping / Cindy engine (FastAPI)
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# OpenAI (Ceevee reports, Cara personas/simulation, Cindy replies)
OPENAI_API_KEY=sk-...

# Optional: API key required by the Chrome extension when pushing LinkedIn cookies
# API_KEY=change-me

# Next.js URL (for CORS)
NEXT_PUBLIC_URL=http://localhost:3000
